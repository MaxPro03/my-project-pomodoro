# PostgreSQL. On Neon: the pooled connection string (host with -pooler)
DATABASE_URL=postgresql://apelsini:apelsini@localhost:5432/apelsini
# optional: direct (non-pooled) connection for `prisma migrate`; falls back to DATABASE_URL
DIRECT_URL=
# encrypts the session cookie, at least 32 characters, e.g. `openssl rand -hex 32`
# (nuxt dev generates one into .env automatically)
NUXT_SESSION_PASSWORD=
# Google login: OAuth client from Google Cloud Console (APIs & Services → Credentials),
# authorized redirect URI: <site>/api/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
